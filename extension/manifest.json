{
  "manifest_version": 3,
  "name": "PII Shield",
  "version": "0.1.0",
  "description": "Prevents company-sensitive data from reaching ChatGPT/Claude/Gemini by tokenizing it before it leaves the browser.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-isolated.js"],
      "run_at": "document_end"
    }
  ]
}
