DATABASE_URL="postgresql://pii:pii_dev_password@localhost:5433/pii_shield?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1h"

# Single operator account, gates POST /admin/companies and its GET/DELETE by
# id (the super-admin app's own login) - both required together, see
# common/guards/super-admin.guard.ts.
SUPER_ADMIN_USERNAME="change-me-in-production"
SUPER_ADMIN_PASSWORD="change-me-in-production"

PORT=3000

# Daily logical DB backup (see BUILD_LOG.md "Postgres backups" for why this
# exists instead of Railway's native volume backups). In production, point
# this at a path on a dedicated Railway volume attached to this service so
# backups survive independently of the Postgres volume; defaults to
# ./backups for local dev if unset.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
