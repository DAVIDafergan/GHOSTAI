{
  "name": "connector",
  "version": "0.0.1",
  "private": true,
  "description": "PII Shield connector: scans a customer data source and sends only entity hashes to the PII Shield backend.",
  "bin": {
    "pii-shield-connector": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:integration": "ts-node test/sync.integration.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "csv-parse": "^5.6.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "rootDir": "."
  }
}
